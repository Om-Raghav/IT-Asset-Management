PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/itams
# Set to true to run without installing MongoDB (spins up an in-memory DB automatically)
USE_MEMORY_DB=false
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://127.0.0.1:5500

# Automatic notification scheduler (warranty/AMC expiry + duplicate detection alerts)
NOTIFICATION_CHECK_INTERVAL_HOURS=24
WARRANTY_ALERT_DAYS=30
AMC_ALERT_DAYS=30

# Optional: powers the chat assistant with a real LLM via Groq's free API
# instead of the built-in keyword-matching fallback. Get a free key at
# https://console.groq.com - leave blank to keep using the fallback.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
